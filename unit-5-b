#include <iostream>

using namespace std;
class Student {
private:
string name;
int age;
public:
Student()
{
name = "sitha";
age = 19;
}
Student(string n) {
name = n;
age = 10;
}
Student(string n, int a) {
name = n;
age = a;
}
void display() {
cout << "Name: " << name << ", Age: " << age << endl;
}
};
int main() {
Student s1;
Student s2("sam");
Student s3("ram", 20);
s1.display();
s2.display();
s3.display();

return 0;
}
