if (amount > 0) {
acc.balance += amount;
cout << "Deposited $" << amount << endl;
} else {
cout << "Invalid deposit amount."
<< endl;
}
}
void withdraw(BankAccount& acc, double amount) {
if (amount > 0 && amount <= acc.balance) {
acc.balance -= amount;
cout << "Withdrew $" << amount << endl;
} else {
cout << "Withdrawal failed: Insufficient funds or invalid
amount."
<< endl;
}
}
void displayAccount(const BankAccount& acc) {
cout << "\n--- Account Details ---" << endl;
cout << "Account Number: " << acc.accountNumber << endl;
cout << "Account Holder: " << acc.ownerName << endl;
cout << "Current Balance: $" << acc.balance << endl;
cout << "-----------------------\n" << endl;
}
