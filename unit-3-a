#include <iostream>
#include <string>
using namespace std;
struct BankAccount {
long accountNumber;
string ownerName;
double balance;
};
void createAccount(BankAccount& acc, long number, string name,
double initialBalance) {
acc.accountNumber = number;
acc.ownerName = name;
acc.balance = initialBalance;
}
void deposit(BankAccount& acc, double amount) {
