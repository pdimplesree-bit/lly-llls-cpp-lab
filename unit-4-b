#include <iostream>
#include <string>
using namespace std;
// Function with default arguments
void printMessage(string text, int count = 1, char symbol = '*') {
for (int i = 0; i < count; ++i) {
cout << text << symbol << endl;
}
}
int main() {
// Call with all arguments
printMessage("Hello", 3, '!');
// Call with two arguments, using default for symbol
printMessage("World", 2);
// Call with one argument, using defaults for count and symbol
printMessage("Goodbye");
return 0;
}
