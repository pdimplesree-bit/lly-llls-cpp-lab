#include <iostream>
#include <string>
using namespace std;
struct Student {
private:
string studentName;
int studentId;
friend void displayStudentInfo(const Student& s);
public:
Student(string name, int id) : studentName(name), studentId(id)
{}
};
void displayStudentInfo(const Student& s) {
cout << "Student Name: " << s.studentName << endl;
cout << "Student ID: " << s.studentId << endl;
}
int main() {
Student s1("Alice", 101);
displayStudentInfo(s1);
return 0;
}
