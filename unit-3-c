#include <iostream>
using namespace std;
struct Rectangle {
double width, height;
};
Rectangle& setWidth(Rectangle& rect, double width) {
rect.width = width;
return rect;
}
Rectangle& setHeight(Rectangle& rect, double height) {
rect.height = height;
return rect;
}
void printArea(const Rectangle& rect) {
cout << "Area: " << rect.width * rect.height << endl;
}
int main() {
Rectangle r1;
setWidth(setHeight(r1, 10.0), 5.0);
printArea(r1);
return 0;}
